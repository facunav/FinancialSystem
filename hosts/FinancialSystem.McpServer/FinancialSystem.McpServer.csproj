<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\FinancialSystem.Application\FinancialSystem.Application.csproj" />
    <ProjectReference Include="..\..\src\FinancialSystem.Infrastructure\FinancialSystem.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Patch 0062 (PATCH-013): habilita "dotnet user-secrets" para este host, mismo
         mecanismo que ya tenían FinancialMcp.Api y FinancialSystem.Worker. Sin esto,
         Host.CreateApplicationBuilder no agrega el proveedor de User Secrets en
         Development, aunque el resto de la resolución de configuración sí funcione. -->
    <UserSecretsId>dotnet-FinancialSystem.McpServer-207f8875-e8ab-4c0b-8c34-10f6eeea8259</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.7" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectTools.cs lee docs/ desde el directorio de salida del build en tiempo de
         ejecución: mismo mecanismo de copia que ya usa este proyecto para
         appsettings.json/appsettings.Development.json, aplicado acá a docs/**/*.md
         preservando la estructura de carpetas original. -->
    <None Include="..\..\docs\**\*.md">
      <Link>docs\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
