# Configuración centralizada para los scripts de backup/restore de FinancialMcp (Patch 0049).
#
# Copiar este archivo a "backup.env" (misma carpeta) y completar con valores reales.
# "backup.env" NO debe subirse al repositorio — ya está excluido en .gitignore.
# Los scripts de backup y de restore (.sh y .ps1) leen este mismo archivo: es la
# única fuente de configuración, no hay rutas ni credenciales hardcodeadas en los scripts.

# ---- Conexión a PostgreSQL ----
# PGHOST/PGPORT/PGDATABASE/PGUSER/PGPASSWORD son variables estándar de libpq:
# pg_dump, pg_restore, dropdb y createdb las leen automáticamente sin necesidad
# de pasar flags adicionales.
PGHOST=localhost
PGPORT=5432
PGDATABASE=financialsystem
PGUSER=postgres

# Recomendado: NO completar PGPASSWORD acá. Usar en su lugar un archivo
# ~/.pgpass (Linux/macOS) o %APPDATA%\postgresql\pgpass.conf (Windows) — ver
# docs/BACKUP_AND_RESTORE.md. Si no es posible, se puede descomentar y completar
# acá como último recurso, sabiendo que "backup.env" queda fuera de git pero no
# queda cifrado en disco.
#PGPASSWORD=

# ---- Backups ----
# Carpeta local donde se guardan los archivos .dump generados. Se crea sola si
# no existe. Usar una ruta absoluta de tu equipo (no se versiona este archivo
# con valores reales, así que no hay problema en poner una ruta específica acá).
# Ejemplo Linux/macOS: /home/tu-usuario/backups/financialmcp
# Ejemplo Windows:     C:\Backups\FinancialMcp
BACKUP_DIR=./backups

# Días de retención del backup automático diario: los .dump con fecha de
# modificación más vieja que este número de días se eliminan al correr el
# script de backup. Ver "Estrategia de retención" en docs/BACKUP_AND_RESTORE.md.
RETENTION_DAYS=14

# ---- Opcional ----
# Carpeta donde están pg_dump/pg_restore/dropdb/createdb si no están en el PATH
# del sistema (frecuente en Windows). Si están en el PATH, dejar vacío.
# Ejemplo Windows: C:\Program Files\PostgreSQL\16\bin
#PG_BIN_DIR=
