<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DEDUPE-004-CONV: herramienta de consola AISLADA, exclusivamente de lectura,
    para ejecutar IDedupeEngine.PreviewAsync contra una base real.

    DELIBERADAMENTE NO reutiliza ninguno de los 3 hosts existentes (FinancialMcp.Api,
    FinancialSystem.Worker, FinancialSystem.McpServer): los 3 llaman
    DatabaseMigrationExtensions.ApplyMigrationsAsync en su Program.cs, lo que aplicaría
    automáticamente CUALQUIER migración pendiente (incluida AddMovementIdentityLink)
    apenas arrancan, exactamente lo que esta etapa NO debe hacer. Esta herramienta
    nunca llama a esa clase, nunca llama a ApplyAsync, nunca llama a SaveChanges.

    No se agregó al .sln, se ejecuta manualmente (ver el comando de uso en Program.cs),
    nunca corre como parte de un build/test normal.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FinancialSystem.Application\FinancialSystem.Application.csproj" />
    <ProjectReference Include="..\..\src\FinancialSystem.Domain\FinancialSystem.Domain.csproj" />
    <ProjectReference Include="..\..\src\FinancialSystem.Infrastructure\FinancialSystem.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
